# Local development only. Copy to .env; never commit credentials.
# make dev-api reads this file; production reads the process environment.
DATABASE_URL=postgres://hooklane:hooklane_local@127.0.0.1:5438/hooklane?sslmode=disable
HTTP_ADDR=127.0.0.1:8088
LOG_LEVEL=info
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
# Optional: serve a built frontend with the local Go binary.
WEB_DIR=
API_PROXY_TARGET=http://127.0.0.1:8088

# Compose database credentials and host ports. For local development, keep
# DATABASE_URL and API_PROXY_TARGET above in sync with these values.
POSTGRES_USER=hooklane
POSTGRES_PASSWORD=hooklane_local
POSTGRES_DB=hooklane
POSTGRES_PORT=5438
APP_PORT=8088

# Required secrets. Run make setup to generate these once in .env.
# ADMIN_TOKEN authorizes management; INGEST_TOKEN only accepts events.
ADMIN_TOKEN=
INGEST_TOKEN=
# 32 random bytes encoded as 64 hex characters. Never replace on an existing DB.
ENCRYPTION_KEY=
# Enable behind HTTPS. Local loopback development uses HTTP.
SECURE_COOKIES=false
MAX_PAYLOAD_BYTES=1048576
WORKER_CONCURRENCY=4
DELIVERY_TIMEOUT=10s
WORKER_POLL_INTERVAL=1s
RETRY_BASE=5s
MAX_ATTEMPTS=8
RETENTION=720h
# Outbound HTTPS/public addresses only by default. Explicit development opt-ins:
ALLOW_HTTP_DESTINATIONS=false
DESTINATION_ALLOWED_CIDRS=
